# Carve runs on your own model key.
# Choose ONE provider below, fill in its key, then start the app with: npm run desktop
#
# Settings carry a STEWARD_ prefix: Steward was the project's working name before it was Carve.

# ── OpenAI: the most tested path ──────────────────────────────────────────────────────────────
STEWARD_PROVIDER=openai-hosted
OPENAI_API_KEY=
# STEWARD_OPENAI_STRATEGY_MODEL=gpt-6-sol         # planning, recovery and final checks (default)
# STEWARD_OPENAI_EXECUTION_MODEL=gpt-6-luna       # frequent action and verification calls (default)

# ── OpenRouter: one key, many models (experimental) ───────────────────────────────────────────
# Works for questions and for tasks in browser windows. Acting in other Mac apps needs a provider with
# computer-use sessions, such as OpenAI above. The model must accept images and structured output.
# STEWARD_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# STEWARD_OPENROUTER_MODEL=openai/gpt-6-sol            # planning, recovery and final checks
# STEWARD_OPENROUTER_FAST_MODEL=openai/gpt-6-luna      # frequent action calls; defaults to the model above when you change it
# STEWARD_OPENROUTER_DATA_COLLECTION=deny              # deny (default): only upstream providers that do not collect prompts
# STEWARD_OPENROUTER_REASONING_EFFORT=low              # low (default), none, medium, high, or off for models without reasoning

# ── Anthropic (experimental) ──────────────────────────────────────────────────────────────────
# STEWARD_PROVIDER=anthropic-hosted
# ANTHROPIC_API_KEY=
# STEWARD_ANTHROPIC_MODEL=claude-sonnet-5

# ── AWS Bedrock (experimental). Use a short-term, Region-bound Bedrock API key. ───────────────
# STEWARD_PROVIDER=aws-bedrock
# AWS_BEARER_TOKEN_BEDROCK=
# STEWARD_BEDROCK_REGION=us-west-2
# STEWARD_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6

# ── Azure OpenAI (experimental) ───────────────────────────────────────────────────────────────
# STEWARD_PROVIDER=azure-openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# STEWARD_AZURE_OPENAI_DEPLOYMENT=<deployment-name>

# ── A local OpenAI-compatible server: Ollama, LM Studio, llama.cpp, vLLM (experimental) ───────
# Acting on a window needs a vision-capable model.
# STEWARD_PROVIDER=local-openai-compatible
# STEWARD_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# STEWARD_LOCAL_MODEL=<model-name>
# STEWARD_LOCAL_CAPABILITIES=text,vision,structured_output

# ── No key yet? The deterministic mock provider opens the app without calling any model. ──────
# STEWARD_PROVIDER=mock

# ── Optional ──────────────────────────────────────────────────────────────────────────────────
# STEWARD_DATA_DIR=./data        # where the local database lives in a source build
# STEWARD_PORT=4377              # the app's loopback port
# DEEPGRAM_API_KEY=              # voice dictation and spoken replies
